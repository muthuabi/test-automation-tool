# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb+srv://admin:admin.coros.in@mkcluster0.roebmlo.mongodb.net/?retryWrites=true&w=majority&appName=MkCluster0
# For MongoDB Atlas (optional): MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/test-automation-tool?retryWrites=true&w=majority

# Demo Site Configuration
DEMO_SITE_URL=http://localhost:3001

# Email Configuration (Optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
FROM_ADDRESS=noreply@testautomation.com

# ADO Configuration (Optional)
ADO_PROJECT_URL=https://dev.azure.com/your-org/your-project
ADO_PAT=your-personal-access-token

# Teams Configuration (Optional)
TEAMS_WEBHOOK_URL=https://outlook.webhook.office.com/webhookb2/...

# Playwright Configuration
PLAYWRIGHT_TIMEOUT=30000
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_SLOWMO=0
